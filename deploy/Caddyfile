{
	email {$ACME_EMAIL:admin@example.com}
}

{$APP_DOMAIN} {
	reverse_proxy web:3000
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-X-Powered-By
		-Server
	}
}

{$API_DOMAIN} {
	reverse_proxy api:3001 {
		flush_interval -1
	}
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-X-Powered-By
		-Server
	}
}

{$DB_DOMAIN} {
	reverse_proxy kong:8000
	encode zstd gzip

	@studio path /studio* /project*
	respond @studio 404

	@direct {
		path /rest/v1* /graphql/v1* /storage/v1*
		not path /storage/v1/object/sign/* /storage/v1/object/upload/sign/*
	}
	respond @direct 404
}
