{
	email {$ACME_EMAIL:admin@example.com}
}

{$APP_DOMAIN} {
	reverse_proxy web:3000
	encode zstd gzip
}

{$API_DOMAIN} {
	reverse_proxy api:3001 {
		# sse must not be buffered, otherwise the answer arrives in stutters
		flush_interval -1
	}
	encode zstd gzip
}

{$DB_DOMAIN} {
	reverse_proxy kong:8000
	encode zstd gzip

	# the studio is not meant to be public
	@studio path /studio* /project*
	respond @studio 404
}
