{
	"name": "notebooklm-clone",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "pnpm --filter shared build",
		"dev": "pnpm --filter shared build && pnpm --parallel --filter \"./apps/*\" dev",
		"build": "pnpm --filter shared build && pnpm --parallel --filter \"./apps/*\" build",
		"test": "pnpm --filter shared build && pnpm --recursive test",
		"lint": "pnpm --recursive lint",
		"format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"seed:demo": "node scripts/seed-demo.mjs",
		"reembed": "node scripts/reembed-all.mjs"
	},
	"devDependencies": {
		"@supabase/supabase-js": "^2.112.0",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"typescript": "^5.9.3"
	}
}
